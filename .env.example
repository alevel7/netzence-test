# ------------------------------------------------------------------------------
# Application Environment Configuration
# ------------------------------------------------------------------------------

# Environment: development, staging, production
ENVIRONMENT=development
DEBUG=true
APP_NAME="Production FastAPI Service"
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=1

# Security & CORS
# Comma-separated list or JSON array of allowed origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_db

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ------------------------------------------------------------------------------
# Redis Configuration
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_EXPIRE_SECONDS=300

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Log format: json (production) or text (local development)
LOG_FORMAT=text


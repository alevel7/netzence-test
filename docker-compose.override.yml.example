# Example Docker Compose override for local development with live reload.
# Copy this file to `docker-compose.override.yml` to activate:
#   cp docker-compose.override.yml.example docker-compose.override.yml
# Docker Compose automatically merges docker-compose.override.yml if present.

services:
  web:
    # Mount local directory into container to enable live code editing
    volumes:
      - .:/app
    # Run uvicorn with hot reload enabled
    command: ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
    environment:
      - DEBUG=true
      - ENVIRONMENT=development

